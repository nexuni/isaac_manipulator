<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_gripper">

  <!-- robot name parameter -->
  <xacro:arg name="name" default="ur"/>
  <!-- parameters -->
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:include filename="$(find isaac_manipulator_pick_and_place)/srdf/robotiq_hande.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>
  <xacro:robotiq_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <!-- disable_collisions between robot end effector and gripper -->
  <disable_collisions link1="wrist_3_link" link2="robotiq_hande_coupler" reason="Adjacent" />
  <disable_collisions link1="wrist_3_link" link2="robotiq_hande_link" reason="Adjacent" />
  <disable_collisions link1="wrist_3_link" link2="robotiq_hande_left_finger" reason="Never" />
  <disable_collisions link1="wrist_3_link" link2="robotiq_hande_right_finger" reason="Never" />
  <disable_collisions link1="wrist_3_link" link2="robotiq_hande_end" reason="Never" />
  <disable_collisions link1="wrist_2_link" link2="robotiq_hande_coupler" reason="Never" />
  <disable_collisions link1="wrist_2_link" link2="robotiq_hande_link" reason="Never" />
  <disable_collisions link1="wrist_2_link" link2="robotiq_hande_left_finger" reason="Never" />
  <disable_collisions link1="wrist_2_link" link2="robotiq_hande_right_finger" reason="Never" />
  <disable_collisions link1="wrist_2_link" link2="robotiq_hande_end" reason="Never" />
  <disable_collisions link1="tool0" link2="robotiq_hande_coupler" reason="Adjacent" />
  <disable_collisions link1="tool0" link2="robotiq_hande_link" reason="Adjacent" />
  <disable_collisions link1="flange" link2="robotiq_hande_coupler" reason="Adjacent" />
  <disable_collisions link1="flange" link2="robotiq_hande_link" reason="Adjacent" />


  <group name="ur_robotiq">
    <chain base_link="base_link" tip_link="robotiq_hande_end" />
  </group>

</robot>
